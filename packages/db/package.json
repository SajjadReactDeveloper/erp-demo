{
  "name": "@erp/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "gen": "tsx scripts/gen-schema.ts && prisma generate --schema prisma/schema.prisma",
    "push": "prisma db push --schema prisma/schema.prisma --skip-generate && tsx scripts/post-push.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@erp/shared": "workspace:*",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "@types/bcryptjs": "^2.4.6"
  }
}
