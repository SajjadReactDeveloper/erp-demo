DATABASE_URL=postgresql://erp:erp@localhost:5433/erp
JWT_SECRET=change-me-to-a-long-random-string
API_PORT=4010
WEB_ORIGIN=http://localhost:3010
NEXT_PUBLIC_API_URL=http://localhost:4010

# Number of reverse proxies in front of the API (e.g. 1), or a comma-separated list of proxy IPs/CIDRs. Leave unset when clients connect directly.
# TRUST_PROXY=1
# Single-tenant Microsoft SSO: required for Microsoft sign-in to work (fails closed without it).
# OIDC_MICROSOFT_TENANT=

# --- AI engine (optional). Any OpenAI-compatible endpoint; then set Settings > AI > ai.provider to 'llm'.
# Enables: free-form assistant questions, reading photographed/scanned supplier quotes, smarter part matching and message parsing.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_VISION_MODEL=gpt-4o-mini

# --- E-mail (SMTP). Used for scheduled reports, notification rules and customer e-mails.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# (or) SMTP_HOST= / SMTP_PORT=587 / SMTP_USER= / SMTP_PASS= / SMTP_SECURE=0
# EMAIL_FROM=AutocQuick <no-reply@example.com>

# --- WhatsApp Business Cloud API (Meta). Outgoing + incoming requests.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=          # you choose; paste into Meta's webhook setup (callback: /api/v1/public/whatsapp/webhook)
# WHATSAPP_APP_SECRET=            # verifies incoming webhook signatures
# WHATSAPP_TEMPLATES={"quotation_sent":{"name":"quotation_sent","ar":"ar","en":"en"}}   # approved templates for business-initiated messages

# --- Inbound e-mail relay: POST JSON {from, subject, text} to /api/v1/public/inbound-email with header x-inbound-secret
# INBOUND_EMAIL_SECRET=

# --- File storage: local disk by default; set S3_BUCKET for any S3-compatible bucket (AWS S3, MinIO, Cloudflare R2, Spaces)
# S3_BUCKET= / S3_REGION=us-east-1 / S3_ENDPOINT= / S3_ACCESS_KEY_ID= / S3_SECRET_ACCESS_KEY= / S3_FORCE_PATH_STYLE=1
